<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="The guild {{ guildName }} was not found on {{ realmName }}. Check the realm and spelling, then search again.">
    <title>{{ guildName }} not found — Warmane Armory</title>
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
</head>
<body>
<div class="armory-wrapper not-found-layout">
    {% include '_site_header.html.twig' with {currentRealm: realmName} %}
    <main class="not-found-content">
        <section class="not-found-card" aria-labelledby="guild-not-found-title">
            <h1 id="guild-not-found-title">Guild not found</h1>
            <p>Could not find &lt;{{ guildName }}&gt; on {{ realmName }}, or Warmane is temporarily unavailable.</p>
            <p class="not-found-hint">Check the guild spelling and selected realm, then search again above.</p>
        </section>
    </main>
</div>
</body>
</html>
