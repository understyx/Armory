<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Browse {{ guild.memberCount }} members of {{ guild.name }} on {{ guild.realm }}, with classes, professions, achievements and Uwu-logs rankings.">
    <title>{{ guild.name }} @ {{ guild.realm }} — Warmane Guild</title>
    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <script type="module" src="{{ asset('guild-roster-sort.js') }}"></script>
</head>
<body>
<main class="armory-wrapper guild-page">
    {% include '_site_header.html.twig' with {currentRealm: guild.realm} %}
    {% for label, messages in flashes %}
        {% for message in messages %}
            <div class="alert-banner {{ label == 'success' ? 'alert-success' : 'alert-warning' }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    <section class="header-card guild-header-card">
        <div class="char-main-info">
            <div class="char-name-row">
                <h1 class="char-name">&lt;{{ guild.name }}&gt;</h1>
                <span class="realm-badge">{{ guild.realm }}</span>
                {% if guild.faction %}<span class="faction-badge faction-{{ guild.faction|lower }}">{{ guild.faction }}</span>{% endif %}
            </div>
            <div class="char-details-sub">Warmane guild roster</div>
            <div class="header-actions guild-header-actions">
                <form action="{{ path('app_guild_refresh', {'guildName': guild.name, 'realmName': guild.realm}) }}" method="post">
                    <button type="submit" class="btn-refresh"{% if not refreshDecision.accepted %} disabled title="Today's refresh was already used. Try again after {{ refreshDecision.retryAt|date('Y-m-d H:i') }}."{% endif %}>Refresh Guild</button>
                </form>
                {% if refreshDecision.accepted %}
                    <div class="scraped-time">Updated {{ guild.scrapedAt|date('Y-m-d H:i', 'UTC') }} UTC · One roster refresh is available each day.</div>
                {% else %}
                    <div class="scraped-time">Updated {{ guild.scrapedAt|date('Y-m-d H:i', 'UTC') }} UTC · Today's refresh is used.</div>
                {% endif %}
            </div>
        </div>
        <div class="stats-row guild-stats-row">
            <div class="stat-pill"><div class="stat-label">Members</div><div class="stat-value">{{ guild.memberCount }}</div></div>
            <div class="stat-pill"><div class="stat-label">PVE Points</div><div class="stat-value">{{ guild.pvePoints|number_format }}</div></div>
        </div>
    </section>

    <section class="content-card section-card">
        <div class="section-header guild-roster-header">
            <div>
                <h2>Guild Roster</h2>
                <p class="section-subtitle">Uwu-logs ranks are collected gradually in the background.</p>
            </div>
        </div>
        <form class="guild-filter-form" action="{{ path('app_guild_view', {'guildName': guild.name, 'realmName': guild.realm}) }}" method="get">
            <label class="visually-hidden" for="guild-member-filter">Filter guild roster by name, class, specialization or profession</label>
            <input id="guild-member-filter" type="search" name="filter" value="{{ memberFilter }}" placeholder="Filter name, class, spec or profession" aria-label="Filter roster by name, class, specialization or profession" autocomplete="off">
            <button type="submit" class="guild-filter-submit">Filter</button>
            <p class="guild-match-count" role="status" aria-live="polite">Showing <span id="guild-match-count">{{ members|length }}</span> of {{ totalMembers }} members</p>
        </form>
        <div class="table-scroll">
            <table class="data-table guild-roster-table" aria-describedby="guild-match-count">
                <thead>
                    <tr>
                        <th aria-sort="none"><button type="button" class="guild-sort-button" data-sort-column="0" data-sort-type="text">Character<span class="sort-indicator" aria-hidden="true"></span></button></th>
                        <th aria-sort="none"><button type="button" class="guild-sort-button" data-sort-column="1" data-sort-type="text">Class<span class="sort-indicator" aria-hidden="true"></span></button></th>
                        <th aria-sort="none"><button type="button" class="guild-sort-button" data-sort-column="2" data-sort-type="number">Level<span class="sort-indicator" aria-hidden="true"></span></button></th>
                        <th aria-sort="none"><button type="button" class="guild-sort-button" data-sort-column="3" data-sort-type="text">Guild rank<span class="sort-indicator" aria-hidden="true"></span></button></th>
                        <th aria-sort="none"><button type="button" class="guild-sort-button" data-sort-column="4" data-sort-type="number">Achievement points<span class="sort-indicator" aria-hidden="true"></span></button></th>
                        <th aria-sort="none"><button type="button" class="guild-sort-button" data-sort-column="5" data-sort-type="text">Professions<span class="sort-indicator" aria-hidden="true"></span></button></th>
                        <th aria-sort="none"><button type="button" class="guild-sort-button" data-sort-column="6" data-sort-type="number">Uwu-logs overall points<span class="sort-indicator" aria-hidden="true"></span></button></th>
                    </tr>
                </thead>
                <tbody>
                {% for member in members %}
                    {% set memberKey = member.name|lower %}
                    {% set rank = ranks[memberKey]|default(null) %}
                    {% set searchable = [member.name, member.race|default(''), member.class|default(''), rank ? rank.specName(member.class|default(null)) : '', member.professions|default([])|join(' ')]|join(' ')|lower %}
                    <tr data-sortable-row data-search="{{ searchable }}">
                        <td><a class="guild-member-link" href="{{ path('app_character_view', {'characterName': member.name, 'realmName': guild.realm}) }}">{{ member.name }}</a>{% if member.race %}<span class="member-race">· {{ member.race }}</span>{% endif %}</td>
                        <td><span class="class-{{ member.class|default('unknown')|lower|replace({' ': '-'}) }}">{{ member.class|default('Unknown') }}</span></td>
                        <td>{{ member.level }}</td>
                        <td>{{ member.rank|default('—') }}</td>
                        <td>{{ member.achievementPoints|number_format }}</td>
                        <td>{{ member.professions is not empty ? member.professions|join(', ') : '—' }}</td>
                        <td class="guild-uwu-rank{% if rank and rank.overallPoints == 0 %} is-zero{% endif %}">{% if rank %}<div class="guild-uwu-rank-line"><strong style="color: {{ rank.scoreColor }}">{{ rank.overallPoints|number_format(2) }} points</strong><span>{% if rank.overallRank > 0 %}#{{ rank.overallRank|number_format }} · {% endif %}{{ rank.specName(member.class|default(null)) }}</span></div>{% else %}<span class="rank-pending">Pending</span>{% endif %}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="7">{% if memberFilter %}No members match this filter.{% else %}No members were found in this guild roster.{% endif %}</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
</main>
</body>
</html>
