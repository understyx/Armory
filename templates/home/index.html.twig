<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Armory</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
</head>
<body>
    <main class="landing-page">
        <section class="landing-content" aria-labelledby="armory-title">
            <h1 id="armory-title" class="landing-title">Armory</h1>

            <form class="character-search" action="{{ path('app_characters') }}" method="get">
                <label class="visually-hidden" for="character">Character name</label>
                <input
                    id="character"
                    class="character-search-input"
                    type="search"
                    name="character"
                    placeholder="Character name"
                    autocomplete="off"
                    required
                    autofocus
                >

                <label class="visually-hidden" for="realm">Realm</label>
                <select id="realm" class="character-search-realm" name="realm" aria-label="Realm">
                    {% for realm in realms %}
                        <option value="{{ realm }}">{{ realm }}</option>
                    {% endfor %}
                </select>

                <button class="character-search-button" type="submit" aria-label="Search for character">
                    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.35-4.35"></path>
                    </svg>
                    <span>Search</span>
                </button>
            </form>
        </section>
    </main>
</body>
</html>
