<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ characterName }} @ {{ realmName }} — Warmane Armory</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    <script type="module" src="{{ asset('item-tooltip.js') }}"></script>
    {% if characterModel %}
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"
                integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
                crossorigin="anonymous"></script>
        <script src="https://wow.zamimg.com/modelviewer/live/viewer/viewer.min.js"></script>
    {% endif %}
</head>
<body>
    <div class="armory-wrapper">

        <form class="character-search character-page-search" action="{{ path('app_characters') }}" method="get" aria-label="Search for another character">
            <label class="visually-hidden" for="character-page-search">Character name</label>
            <input
                id="character-page-search"
                class="character-search-input"
                type="search"
                name="character"
                placeholder="Search another character"
                autocomplete="off"
                required
            >

            <label class="visually-hidden" for="character-page-realm">Realm</label>
            <select id="character-page-realm" class="character-search-realm" name="realm" aria-label="Realm">
                {% for realm in ['Icecrown', 'Lordaeron', 'Onyxia', 'Blackrock'] %}
                    <option value="{{ realm }}"{% if realm == realmName %} selected{% endif %}>{{ realm }}</option>
                {% endfor %}
            </select>

            <button class="character-search-button" type="submit" aria-label="Search for character">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.35-4.35"></path>
                </svg>
                <span>Search</span>
            </button>
        </form>

        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert-banner alert-warning">
                    ⚠️ {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% if warningMessage %}
            <div class="alert-banner alert-warning">
                ⚠️ {{ warningMessage }}
            </div>
        {% endif %}

        {% set classCss = 'class-' ~ characterDetails.class|lower|replace({' ': '-'}) %}

        {# Header Card #}
        <div class="header-card">
            <div class="char-main-info">
                <div class="char-name-row">
                    <h1 class="char-name {{ classCss }}">{{ characterName }}</h1>
                    <span class="realm-badge">{{ realmName }}</span>
                    {% if isWotlkServer %}
                        <span class="expansion-badge">WotLK</span>
                    {% endif %}
                </div>
                <div class="char-details-sub">
                    <span>Level {{ characterDetails.level }}{% if characterDetails.gender %} {{ characterDetails.gender }}{% endif %} {{ characterDetails.race }} <strong class="{{ classCss }}">{{ characterDetails.class }}</strong></span>
                    {% if guild %}
                        <span>&bull; &lt;<a class="guild-name" href="{{ path('app_guild_view', {'guildName': guild, 'realmName': realmName}) }}">{{ guild }}</a>&gt;</span>
                    {% endif %}
                </div>

                <div class="header-actions">
                    <form action="{{ path('app_character_refresh', {'characterName': characterName, 'realmName': realmName}) }}" method="POST">
                        <button type="submit" class="btn-refresh">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M2.13 15.57a10 10 0 1 0 0.57-8.38l5.67-5.67"/></svg>
                            Refresh Data
                        </button>
                    </form>
                    {% if scrapedAt %}
                        <div class="scraped-time">
                            Updated {{ scrapedAt|date('Y-m-d H:i') }} UTC
                            {% if staleAgeDays %}
                                <span class="stale-notice">Hasn't been updated in {{ staleAgeDays }} {{ staleAgeDays == 1 ? 'day' : 'days' }} and could be out of date.</span>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="stats-row">
                <div class="stat-pill">
                    <div class="stat-label">GearScore</div>
                    <div class="stat-value">{{ gearScore }}</div>
                </div>
                <div class="stat-pill">
                    <div class="stat-label">Avg iLvl</div>
                    <div class="stat-value">{{ avgIlvl }}</div>
                </div>
                <div class="stat-pill uwu-rank-pill">
                    <div class="stat-label">Best Uwu-logs Parse</div>
                    <div id="header-uwu-points" class="stat-value" data-points="{{ uwuRank ? uwuRank.overallPoints : 0 }}" data-rank="{{ uwuRank ? uwuRank.overallRank : 0 }}"{% if uwuRank %} style="color: {{ uwuRank.scoreColor }}"{% endif %}>{% if uwuRank %}{{ uwuRank.overallPoints|number_format(2) }}{% else %}—{% endif %}</div>
                    <div id="header-uwu-rank" class="stat-rank">{% if uwuRank and uwuRank.overallRank > 0 %}#{{ uwuRank.overallRank|number_format }}{% endif %}</div>
                    <div id="header-uwu-spec" class="stat-meta">{% if uwuRank %}{{ uwuRank.specName(characterDetails.class) }}{% endif %}</div>
                </div>
            </div>

        </div>

        {# SECTION 1: CHARACTER EQUIPMENT & ITEMS #}
        <div class="content-card section-card">
            <div class="section-header gear-section-header">
                <h2>🛡️ Character Items & Gear</h2>
                {% if transmogItems is not empty %}
                    <details class="transmog-menu">
                        <summary class="btn-transmog">Get transmog</summary>
                        <div class="transmog-list">
                            {% for transmog in transmogItems %}
                                <a
                                    href="https://wotlk.cavernoftime.com/item={{ transmog.id }}"
                                    class="transmog-list-item q-{{ transmog.quality|default(4) }}"
                                    target="_blank"
                                    rel="noopener"
                                >{{ transmog.name }}</a>
                            {% endfor %}
                        </div>
                    </details>
                {% endif %}
            </div>

            <div class="paperdoll-container">
                <div class="paperdoll-main-layout">

                    {# FULL-LAYOUT CHARACTER VIEWPORT #}
                    <div class="paperdoll-viewport">
                        <div class="viewport-backdrop {{ classCss }}">
                            {% if characterModel %}
                                <div
                                    id="character-model-viewer"
                                    class="character-model-viewer"
                                    role="img"
                                    aria-label="Interactive 3D model of {{ characterName }}{% if characterDetails.gender %}, {{ characterDetails.gender|lower }}{% endif %}"
                                ></div>
                                <div id="character-model-status" class="character-model-status" role="status">
                                    <span class="model-loading-spinner" aria-hidden="true"></span>
                                    Loading 3D model…
                                </div>
                            {% else %}
                                <div class="character-model-status is-unavailable">
                                    Refresh character data to load the 3D model.
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    {# LEFT COLUMN (8 slots) #}
                    <div class="paperdoll-column left-column">
                        {% for slotKey in ['head', 'neck', 'shoulder', 'back', 'chest', 'shirt', 'tabard', 'wrist'] %}
                            {% set slot = paperdollSlots[slotKey] %}
                            <div class="paperdoll-row left-row">
                                <div class="paperdoll-slot" aria-label="{{ slot.name }}{% if slot.item %}: {{ slot.item.name }}{% else %} (Empty){% endif %}">
                                    {% if slot.item %}
                                        <a href="https://wotlk.cavernoftime.com/item={{ slot.item.id }}"
                                           class="slot-icon-box q-{{ slot.item.quality|default(1) }}"
                                           data-item-tooltip="{{ slot.item.tooltip_key }}"
                                           rel="item={{ slot.item.id }}{% if slot.item.enchant %}&amp;ench={{ slot.item.enchant }}{% endif %}{% if slot.item.gems|default([]) is not empty %}&amp;gems={{ slot.item.gems|join(':') }}{% endif %}{% if slot.item.transmog %}&amp;transmog={{ slot.item.transmog }}{% endif %}"
                                           target="_blank">
                                            {% if slot.item.icon_url %}
                                                <img src="{{ slot.item.icon_url }}" data-fallback-src="{{ slot.item.icon_fallback_url }}" alt="{{ slot.item.name }}" class="slot-img" onerror="const fallback=this.dataset.fallbackSrc;if(fallback){delete this.dataset.fallbackSrc;this.src=fallback;}else{this.style.display='none';this.nextElementSibling.style.display='flex';}" />
                                            {% endif %}
                                            <div class="slot-fallback-symbol" {% if slot.item.icon_url %}style="display:none;"{% endif %}>{{ slot.fallback }}</div>
                                            <div class="slot-quality-glow"></div>
                                            {% if slot.item.ilvl > 0 %}
                                                <span class="slot-ilvl-badge q-{{ slot.item.quality|default(1) }}">{{ slot.item.ilvl }}</span>
                                            {% endif %}
                                        </a>
                                    {% else %}
                                        <div class="slot-icon-box slot-empty">
                                            <div class="slot-fallback-symbol">{{ slot.fallback }}</div>
                                        </div>
                                    {% endif %}
                                </div>

                                <div class="slot-info-block align-left">
                                    {% if slot.item %}
                                        <a href="https://wotlk.cavernoftime.com/item={{ slot.item.id }}"
                                           class="slot-item-name q-{{ slot.item.quality|default(1) }}"
                                           data-item-tooltip="{{ slot.item.tooltip_key }}"
                                           target="_blank"
                                           rel="item={{ slot.item.id }}{% if slot.item.enchant %}&amp;ench={{ slot.item.enchant }}{% endif %}{% if slot.item.gems|default([]) is not empty %}&amp;gems={{ slot.item.gems|join(':') }}{% endif %}">
                                            {{ slot.item.name }}
                                        </a>
                                        <div class="slot-sub-line">
                                            {% if slot.item.enchant_name %}
                                                <span class="slot-enchant-text">{{ slot.item.enchant_name }}</span>
                                            {% elseif slot.item.should_have_enchant %}
                                                <span class="slot-enchant-missing">❌ No Enchant</span>
                                            {% endif %}

                                            {% if slot.item.gem_details is not empty %}
                                                <div class="slot-gems-inline">
                                                    {% for gem in slot.item.gem_details %}
                                                        {% if gem %}
                                                            <a href="{% if gem.id > 0 %}https://wotlk.cavernoftime.com/item={{ gem.id }}{% else %}javascript:void(0){% endif %}" target="_blank" class="gem-icon-link" title="{{ gem.name }}" {% if gem.id > 0 %}rel="item={{ gem.id }}"{% endif %}>
                                                                <img src="{{ gem.icon_url }}" data-fallback-src="{{ gem.icon_fallback_url }}" alt="{{ gem.name }}" class="gem-icon-img q-{{ gem.quality }}" onerror="const fallback=this.dataset.fallbackSrc;if(fallback){delete this.dataset.fallbackSrc;this.src=fallback;}else{this.style.display='none';}" />
                                                            </a>
                                                        {% endif %}
                                                    {% endfor %}
                                                </div>
                                            {% endif %}
                                        </div>
                                    {% else %}
                                        <span class="slot-empty-title">{{ slot.name }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="paperdoll-center-lane" aria-hidden="true"></div>

                    {# RIGHT COLUMN (8 slots) #}
                    <div class="paperdoll-column right-column">
                        {% for slotKey in ['hands', 'waist', 'legs', 'feet', 'finger1', 'finger2', 'trinket1', 'trinket2'] %}
                            {% set slot = paperdollSlots[slotKey] %}
                            <div class="paperdoll-row right-row">
                                <div class="slot-info-block align-right">
                                    {% if slot.item %}
                                        <a href="https://wotlk.cavernoftime.com/item={{ slot.item.id }}"
                                           class="slot-item-name q-{{ slot.item.quality|default(1) }}"
                                           data-item-tooltip="{{ slot.item.tooltip_key }}"
                                           target="_blank"
                                           rel="item={{ slot.item.id }}{% if slot.item.enchant %}&amp;ench={{ slot.item.enchant }}{% endif %}{% if slot.item.gems|default([]) is not empty %}&amp;gems={{ slot.item.gems|join(':') }}{% endif %}">
                                            {{ slot.item.name }}
                                        </a>
                                        <div class="slot-sub-line">
                                            {% if slot.item.enchant_name %}
                                                <span class="slot-enchant-text">{{ slot.item.enchant_name }}</span>
                                            {% elseif slot.item.should_have_enchant %}
                                                <span class="slot-enchant-missing">❌ No Enchant</span>
                                            {% endif %}

                                            {% if slot.item.gem_details is not empty %}
                                                <div class="slot-gems-inline">
                                                    {% for gem in slot.item.gem_details %}
                                                        {% if gem %}
                                                            <a href="{% if gem.id > 0 %}https://wotlk.cavernoftime.com/item={{ gem.id }}{% else %}javascript:void(0){% endif %}" target="_blank" class="gem-icon-link" title="{{ gem.name }}" {% if gem.id > 0 %}rel="item={{ gem.id }}"{% endif %}>
                                                                <img src="{{ gem.icon_url }}" data-fallback-src="{{ gem.icon_fallback_url }}" alt="{{ gem.name }}" class="gem-icon-img q-{{ gem.quality }}" onerror="const fallback=this.dataset.fallbackSrc;if(fallback){delete this.dataset.fallbackSrc;this.src=fallback;}else{this.style.display='none';}" />
                                                            </a>
                                                        {% endif %}
                                                    {% endfor %}
                                                </div>
                                            {% endif %}
                                        </div>
                                    {% else %}
                                        <span class="slot-empty-title">{{ slot.name }}</span>
                                    {% endif %}
                                </div>

                                <div class="paperdoll-slot" aria-label="{{ slot.name }}{% if slot.item %}: {{ slot.item.name }}{% else %} (Empty){% endif %}">
                                    {% if slot.item %}
                                        <a href="https://wotlk.cavernoftime.com/item={{ slot.item.id }}"
                                           class="slot-icon-box q-{{ slot.item.quality|default(1) }}"
                                           data-item-tooltip="{{ slot.item.tooltip_key }}"
                                           rel="item={{ slot.item.id }}{% if slot.item.enchant %}&amp;ench={{ slot.item.enchant }}{% endif %}{% if slot.item.gems|default([]) is not empty %}&amp;gems={{ slot.item.gems|join(':') }}{% endif %}{% if slot.item.transmog %}&amp;transmog={{ slot.item.transmog }}{% endif %}"
                                           target="_blank">
                                            {% if slot.item.icon_url %}
                                                <img src="{{ slot.item.icon_url }}" data-fallback-src="{{ slot.item.icon_fallback_url }}" alt="{{ slot.item.name }}" class="slot-img" onerror="const fallback=this.dataset.fallbackSrc;if(fallback){delete this.dataset.fallbackSrc;this.src=fallback;}else{this.style.display='none';this.nextElementSibling.style.display='flex';}" />
                                            {% endif %}
                                            <div class="slot-fallback-symbol" {% if slot.item.icon_url %}style="display:none;"{% endif %}>{{ slot.fallback }}</div>
                                            <div class="slot-quality-glow"></div>
                                            {% if slot.item.ilvl > 0 %}
                                                <span class="slot-ilvl-badge q-{{ slot.item.quality|default(1) }}">{{ slot.item.ilvl }}</span>
                                            {% endif %}
                                        </a>
                                    {% else %}
                                        <div class="slot-icon-box slot-empty">
                                            <div class="slot-fallback-symbol">{{ slot.fallback }}</div>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                </div>

                {# BOTTOM ROW (3 slots) #}
                <div class="paperdoll-bottom-row">
                    {% for slotKey in ['mainhand', 'offhand', 'ranged'] %}
                        {% set slot = paperdollSlots[slotKey] %}
                        <div class="paperdoll-bottom-card">
                            <div class="paperdoll-slot" aria-label="{{ slot.name }}{% if slot.item %}: {{ slot.item.name }}{% else %} (Empty){% endif %}">
                                {% if slot.item %}
                                    <a href="https://wotlk.cavernoftime.com/item={{ slot.item.id }}"
                                       class="slot-icon-box q-{{ slot.item.quality|default(1) }}"
                                       data-item-tooltip="{{ slot.item.tooltip_key }}"
                                       rel="item={{ slot.item.id }}{% if slot.item.enchant %}&amp;ench={{ slot.item.enchant }}{% endif %}{% if slot.item.gems|default([]) is not empty %}&amp;gems={{ slot.item.gems|join(':') }}{% endif %}{% if slot.item.transmog %}&amp;transmog={{ slot.item.transmog }}{% endif %}"
                                       target="_blank">
                                        {% if slot.item.icon_url %}
                                            <img src="{{ slot.item.icon_url }}" data-fallback-src="{{ slot.item.icon_fallback_url }}" alt="{{ slot.item.name }}" class="slot-img" onerror="const fallback=this.dataset.fallbackSrc;if(fallback){delete this.dataset.fallbackSrc;this.src=fallback;}else{this.style.display='none';this.nextElementSibling.style.display='flex';}" />
                                        {% endif %}
                                        <div class="slot-fallback-symbol" {% if slot.item.icon_url %}style="display:none;"{% endif %}>{{ slot.fallback }}</div>
                                        <div class="slot-quality-glow"></div>
                                        {% if slot.item.ilvl > 0 %}
                                            <span class="slot-ilvl-badge q-{{ slot.item.quality|default(1) }}">{{ slot.item.ilvl }}</span>
                                        {% endif %}
                                    </a>
                                {% else %}
                                    <div class="slot-icon-box slot-empty">
                                        <div class="slot-fallback-symbol">{{ slot.fallback }}</div>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="slot-info-block align-center">
                                {% if slot.item %}
                                    <a href="https://wotlk.cavernoftime.com/item={{ slot.item.id }}"
                                       class="slot-item-name q-{{ slot.item.quality|default(1) }}"
                                       data-item-tooltip="{{ slot.item.tooltip_key }}"
                                       target="_blank"
                                       rel="item={{ slot.item.id }}{% if slot.item.enchant %}&amp;ench={{ slot.item.enchant }}{% endif %}{% if slot.item.gems|default([]) is not empty %}&amp;gems={{ slot.item.gems|join(':') }}{% endif %}">
                                        {{ slot.item.name }}
                                    </a>
                                    <div class="slot-sub-line center-sub">
                                        {% if slot.item.enchant_name %}
                                            <span class="slot-enchant-text">{{ slot.item.enchant_name }}</span>
                                        {% elseif slot.item.should_have_enchant %}
                                            <span class="slot-enchant-missing">❌ No Enchant</span>
                                        {% endif %}

                                        {% if slot.item.gem_details is not empty %}
                                            <div class="slot-gems-inline">
                                                {% for gem in slot.item.gem_details %}
                                                    {% if gem %}
                                                        <a href="{% if gem.id > 0 %}https://wotlk.cavernoftime.com/item={{ gem.id }}{% else %}javascript:void(0){% endif %}" target="_blank" class="gem-icon-link" title="{{ gem.name }}" {% if gem.id > 0 %}rel="item={{ gem.id }}"{% endif %}>
                                                            <img src="{{ gem.icon_url }}" data-fallback-src="{{ gem.icon_fallback_url }}" alt="{{ gem.name }}" class="gem-icon-img q-{{ gem.quality }}" onerror="const fallback=this.dataset.fallbackSrc;if(fallback){delete this.dataset.fallbackSrc;this.src=fallback;}else{this.style.display='none';}" />
                                                        </a>
                                                    {% endif %}
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </div>
                                {% else %}
                                    <span class="slot-empty-title">{{ slot.name }}</span>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>

            {# Gear audit status #}
            <div class="status-summary-bar gear-audit-status">
                <div class="status-card {% if 'missing' in enchantsStatus %}status-warn{% else %}status-ok{% endif %}">
                    <strong>Enchants:</strong> {{ enchantsStatus }}
                </div>
                <div class="status-card {% if 'missing' in gemsStatus %}status-warn{% else %}status-ok{% endif %}">
                    <strong>Gems:</strong> {{ gemsStatus }}
                </div>
            </div>
        </div>

        {# SECTION 2: CALCULATED CHARACTER STATS #}
        <div class="content-card section-card character-stats-section">
            <div class="section-header stat-section-header">
                <div>
                    <h2>📊 Calculated Stats</h2>
                    <p class="stat-section-intro">Level {{ calculatedStats.level|default(characterDetails.level) }} Wrath values, including equipped gear and permanent talents.</p>
                </div>
            </div>

            {% if calculatedStats.available|default(false) %}
                <div class="calculated-stat-table-wrap">
                    <table class="calculated-stat-table">
                        <thead>
                            <tr>
                                <th>Attribute</th>
                                <th>Race</th>
                                <th>Class base</th>
                                <th>Level growth</th>
                                <th>Gear</th>
                                <th>Talents</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for stat in calculatedStats.primary %}
                                <tr>
                                    <th scope="row">{{ stat.name }}</th>
                                    <td>{{ stat.race >= 0 ? '+' : '' }}{{ stat.race }}</td>
                                    <td>{{ stat.class }}</td>
                                    <td>+{{ stat.level }}</td>
                                    <td>{{ stat.gear >= 0 ? '+' : '' }}{{ stat.gear }}</td>
                                    <td>{{ stat.talents >= 0 ? '+' : '' }}{{ stat.talents }}</td>
                                    <td class="calculated-stat-total">{{ stat.total }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {% if calculatedStats.secondary is not empty %}
                    <div class="secondary-stat-grid" aria-label="Equipment stats">
                        {% for stat in calculatedStats.secondary %}
                            <div class="secondary-stat-card">
                                <span>{{ stat.name }}</span>
                                <strong>{{ stat.value|number_format }}</strong>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if calculatedStats.ratings is not empty %}
                    <h3 class="stat-subheading">Rating conversions</h3>
                    <div class="rating-conversion-grid">
                        {% for rating in calculatedStats.ratings %}
                            <div class="rating-conversion-card">
                                <span class="rating-conversion-name">{{ rating.name }}</span>
                                <strong>{{ rating.percent|number_format(2) }}%</strong>
                                <small>{{ rating.rating }} rating · {{ rating.ratingPerPercent }} per 1%</small>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if calculatedStats.talentModifiers is not empty %}
                    <div class="talent-modifier-summary">
                        <strong>Applied talents:</strong>
                        {% for talent in calculatedStats.talentModifiers %}
                            <span>{{ talent.name }} ({{ talent.points }} {{ talent.points == 1 ? 'point' : 'points' }})</span>{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}

                <ul class="stat-calculation-notes">
                    {% for note in calculatedStats.notes %}<li>{{ note }}</li>{% endfor %}
                </ul>
            {% else %}
                <p class="stat-unavailable">{{ calculatedStats.reason|default('Stats could not be calculated for this character.') }}</p>
            {% endif %}
        </div>

        {# SECTION 3: PROFESSIONS #}
        <div class="content-card section-card professions-section">
            <div class="section-header">
                <h2>📜 Professions</h2>
            </div>
            {% if professions is not empty %}
                <div class="professions-grid">
                    {% for profession in professions %}
                        <div class="profession-card">
                            <span class="prof-icon">🛠️</span>
                            <span class="prof-name">{{ profession }}</span>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <p style="color: var(--text-muted);">No professions learned.</p>
            {% endif %}
        </div>

        {# SECTION 4: SPECIALIZATION & TALENT TREES #}
        <div class="content-card section-card">
            <div class="section-header spec-section-header">
                <h2>⚔️ Specialization & Talent Trees</h2>
                {% if parsedSpecs|length > 1 %}
                    <div class="spec-toggle-group">
                        {% for spec in parsedSpecs %}
                            <button class="spec-toggle-btn {% if loop.first %}active{% endif %}" onclick="setSpec('{{ spec.specId }}', this)">
                                {{ spec.specName }} ({{ spec.pointsSummary }})
                            </button>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            {% for spec in parsedSpecs %}
                <div id="spec-pane-{{ spec.specId }}" class="spec-pane {% if loop.first %}active{% endif %}">

                    {# MAIN TALENT CALCULATOR LAYOUT (3 TREES + GLYPHS SIDEBAR) #}
                    <div class="talent-calculator-layout">

                        {# LEFT / CENTER: 3 TALENT TREES COLUMN #}
                        <div class="talent-trees-container">
                            <div class="talent-trees-grid">
                                {% for tree in spec.trees %}
                                    <div class="talent-tree-column">
                                        <div class="talent-tree-grid-box">
                                            {% if tree.tiers is not empty %}
                                                {% for tier in tree.tiers %}
                                                    <div class="talent-tier-row">
                                                        {% for colIdx in 0..3 %}
                                                            {% set talent = tier[colIdx] ?? null %}
                                                            {% if talent %}
                                                                <a href="{{ talent.href }}"
                                                                   target="_blank"
                                                                   rel="spell={{ talent.spellId }}"
                                                                   class="talent-icon-box status-{{ talent.status }}"
                                                                   title="Spell #{{ talent.spellId }}: {{ talent.pointsText }}">
                                                                    {% if talent.iconUrl %}
                                                                        <img src="{{ talent.iconUrl }}" data-fallback-src="{{ talent.iconFallbackUrl }}" alt="Talent" class="talent-icon-img" onerror="const fallback=this.dataset.fallbackSrc;if(fallback){delete this.dataset.fallbackSrc;this.src=fallback;}else{this.style.opacity='0';}" />
                                                                    {% endif %}
                                                                    <div class="talent-rank-badge status-{{ talent.status }}">
                                                                        {{ talent.pointsText }}
                                                                    </div>
                                                                </a>
                                                            {% else %}
                                                                <div class="talent-slot-cell empty-slot"></div>
                                                            {% endif %}
                                                        {% endfor %}
                                                    </div>
                                                {% endfor %}
                                            {% else %}
                                                {# FALLBACK IF FULL GRID NOT AVAILABLE #}
                                                <div class="fallback-tree-info">
                                                    <h4>{{ tree.name }}</h4>
                                                    <p>{{ tree.points }} Points Spent</p>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>

                            {# TREE FOOTER SUMMARY ROW (MATCHING SCREENSHOT) #}
                            <div class="talent-trees-footer">
                                {% for tree in spec.trees %}
                                    <div class="tree-footer-item">
                                        {% if tree.iconUrl %}
                                            <img src="{{ tree.iconUrl }}" data-fallback-src="{{ tree.iconFallbackUrl }}" alt="{{ tree.name }}" class="tree-footer-icon" onerror="const fallback=this.dataset.fallbackSrc;if(fallback){delete this.dataset.fallbackSrc;this.src=fallback;}else{this.style.display='none';}" />
                                        {% endif %}
                                        <span class="tree-footer-name">{{ tree.name }}</span>
                                        <span class="tree-footer-points">{{ tree.points }}</span>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>

                        {# RIGHT SIDE: GLYPHS PANEL #}
                        {% if isWotlkServer %}
                            {% set specGlyphs = glyphs[spec.specId] ?? null %}
                            <div class="glyphs-sidebar">
                                {# MAJOR GLYPHS #}
                                <div class="glyph-section major-section">
                                    <h3 class="glyph-section-header major-header">Major Glyphs</h3>
                                    <div class="glyph-items-list">
                                        {% if specGlyphs and specGlyphs['Major Glyphs'] is defined and specGlyphs['Major Glyphs'] is not empty %}
                                            {% for glyph in specGlyphs['Major Glyphs'] %}
                                                <div class="glyph-item major-item">
                                                    <span class="glyph-ring-dot gold-ring"></span>
                                                    <span class="glyph-text">{{ glyph }}</span>
                                                </div>
                                            {% endfor %}
                                        {% else %}
                                            <div class="glyph-item empty-glyph-item">
                                                <span class="glyph-ring-dot empty-ring"></span>
                                                <span class="glyph-text muted">No Major Glyphs</span>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>

                                {# MINOR GLYPHS #}
                                <div class="glyph-section minor-section">
                                    <h3 class="glyph-section-header minor-header">Minor Glyphs</h3>
                                    <div class="glyph-items-list">
                                        {% if specGlyphs and specGlyphs['Minor Glyphs'] is defined and specGlyphs['Minor Glyphs'] is not empty %}
                                            {% for glyph in specGlyphs['Minor Glyphs'] %}
                                                <div class="glyph-item minor-item">
                                                    <span class="glyph-ring-dot blue-ring"></span>
                                                    <span class="glyph-text">{{ glyph }}</span>
                                                </div>
                                            {% endfor %}
                                        {% else %}
                                            <div class="glyph-item empty-glyph-item">
                                                <span class="glyph-ring-dot empty-ring"></span>
                                                <span class="glyph-text muted">No Minor Glyphs</span>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                    </div>

                    {% if spec.digitString %}
                        <div class="talent-code-box">
                            <span class="code-label">Talent Distribution String:</span>
                            <code>{{ spec.digitString }}</code>
                        </div>
                    {% endif %}
                </div>
            {% endfor %}
        </div>

        {# SECTION 4: UWU-LOGS RAID RANKINGS (FETCHED ONLY ON REQUEST) #}
        {% set uwuSpecOptionsByClass = {
            'Warrior': {'1': 'Arms', '2': 'Fury', '3': 'Protection'},
            'Paladin': {'1': 'Holy', '2': 'Protection', '3': 'Retribution'},
            'Hunter': {'1': 'Beast Mastery', '2': 'Marksmanship', '3': 'Survival'},
            'Rogue': {'1': 'Assassination', '2': 'Combat', '3': 'Subtlety'},
            'Priest': {'1': 'Discipline', '2': 'Holy', '3': 'Shadow'},
            'Death Knight': {'1': 'Blood', '2': 'Frost', '3': 'Unholy'},
            'Shaman': {'1': 'Elemental', '2': 'Enhancement', '3': 'Restoration'},
            'Mage': {'1': 'Arcane', '2': 'Fire', '3': 'Frost'},
            'Warlock': {'1': 'Affliction', '2': 'Demonology', '3': 'Destruction'},
            'Druid': {'1': 'Balance', '2': 'Feral Combat', '3': 'Restoration'}
        } %}
        {% set uwuSpecOptions = uwuSpecOptionsByClass[characterDetails.class]|default({'1': 'Specialization 1', '2': 'Specialization 2', '3': 'Specialization 3'}) %}
        {% set activeSpecName = parsedSpecs is not empty ? (parsedSpecs|first).specName|lower : '' %}

        <div class="content-card section-card uwu-logs-section">
            <div class="section-header uwu-logs-header">
                <div>
                    <h2>📊 Uwu-logs Raid Rankings</h2>
                    <p class="section-subtitle">Rankings are fetched only when you request them. Results are cached for 30 seconds, with one new request allowed per character during that time.</p>
                </div>
                <div class="uwu-logs-actions">
                    <label for="uwu-logs-spec" class="visually-hidden">Uwu-logs specialization</label>
                    <select id="uwu-logs-spec" class="uwu-spec-select">
                        {% for specId, specName in uwuSpecOptions %}
                            <option value="{{ specId }}"{% if specName|lower == activeSpecName %} selected{% endif %}>{{ specName }}</option>
                        {% endfor %}
                    </select>
                    <button
                        type="button"
                        class="btn-uwu-logs"
                        data-url="{{ path('app_character_uwu_logs', {'characterName': characterName, 'realmName': realmName}) }}"
                        onclick="fetchUwuLogs(this)"
                    >
                        Fetch rankings from Uwu-logs
                    </button>
                </div>
            </div>

            <div id="uwu-logs-status" class="uwu-logs-status" role="status" aria-live="polite">
                Choose a specialization, then fetch rankings to see Uwu-logs data.
            </div>

            <div id="uwu-logs-results" hidden>
                <div class="uwu-overall-grid">
                    <div class="uwu-overall-card">
                        <span class="uwu-overall-label">Overall rank</span>
                        <strong id="uwu-overall-rank" class="uwu-overall-value">—</strong>
                    </div>
                    <div class="uwu-overall-card">
                        <span class="uwu-overall-label">Overall points</span>
                        <strong id="uwu-overall-points" class="uwu-overall-value">—</strong>
                    </div>
                    <div class="uwu-overall-card">
                        <span class="uwu-overall-label">Specialization</span>
                        <strong id="uwu-selected-spec" class="uwu-overall-value uwu-spec-value">—</strong>
                    </div>
                </div>

                <div class="table-scroll">
                    <table class="data-table uwu-rankings-table">
                        <thead>
                            <tr>
                                <th>Encounter</th>
                                <th>DPS</th>
                                <th>Player rank</th>
                                <th>Raid rank</th>
                                <th>Points</th>
                                <th>Fastest kill</th>
                            </tr>
                        </thead>
                        <tbody id="uwu-rankings-body"></tbody>
                    </table>
                </div>
            </div>
        </div>

        {# SECTION 5: KILL STATS #}
        <div class="content-card section-card">
            <div class="section-header">
                <h2>⚔️ Kill Statistics</h2>
            </div>
            {% if killStats is not empty %}
                <div class="table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Category / Encounter</th>
                                <th>Count</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if killStats.stats is defined %}
                                {% for description, value in killStats.stats %}
                                    <tr>
                                        <td>{{ description }}</td>
                                        <td><strong style="color: var(--accent-gold);">{{ value }}</strong></td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                {% for description, value in killStats %}
                                    <tr>
                                        <td>{{ description }}</td>
                                        <td><strong style="color: var(--accent-gold);">{{ value }}</strong></td>
                                    </tr>
                                {% endfor %}
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p style="color: var(--text-muted);">No kill statistics available.</p>
            {% endif %}
        </div>

        {# SECTION 6: PVP & ARENA TEAMS #}
        <div class="content-card section-card">
            <div class="section-header">
                <h2>⚔️ Player vs Player & Arena Teams</h2>
            </div>

            <div class="pvp-header-summary">
                <div class="pvp-stat-pill">
                    <span class="icon">🎖️</span>
                    <div>
                        <div class="val">{{ pvpStats.totalKills|default(0)|number_format }}</div>
                        <div class="lbl">Honorable Kills</div>
                    </div>
                </div>
                <div class="pvp-stat-pill">
                    <span class="icon">⚔️</span>
                    <div>
                        <div class="val">{{ pvpStats.killsToday|default(0)|number_format }}</div>
                        <div class="lbl">Kills Today</div>
                    </div>
                </div>
            </div>

            <div class="arena-teams-grid">
                {% set brackets = ['2v2', '3v3', '5v5'] %}
                {% for b in brackets %}
                    {% set teamInfo = null %}
                    {% if pvpStats.arenaTeams is defined and pvpStats.arenaTeams is not empty %}
                        {% for team in pvpStats.arenaTeams %}
                            {% if team.bracket == b %}
                                {% set teamInfo = team %}
                            {% endif %}
                        {% endfor %}
                    {% endif %}

                    <div class="arena-team-card {% if teamInfo %}has-team{% endif %}">
                        <div class="arena-card-top">
                            <span class="bracket-badge">{{ b }} Arena</span>
                            {% if teamInfo and teamInfo.rank %}
                                <span class="rank-badge">Rank #{{ teamInfo.rank }}</span>
                            {% endif %}
                        </div>
                        <div>
                            {% if teamInfo %}
                                {% if teamInfo.url %}
                                    <a href="https://armory.warmane.com{{ teamInfo.url }}" target="_blank" class="team-name-link">{{ teamInfo.name }}</a>
                                {% else %}
                                    <span class="team-name-link">{{ teamInfo.name }}</span>
                                {% endif %}
                                <div class="arena-rating-row">
                                    <span class="rating-number">{{ teamInfo.rating }}</span>
                                    <span class="rating-label">Rating</span>
                                </div>
                            {% else %}
                                <div class="no-team-label">No {{ b }} Team</div>
                                <div class="arena-rating-row">
                                    <span class="rating-number" style="color: var(--text-muted);">0</span>
                                    <span class="rating-label">Rating</span>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        {# SECTION 7: MATCH HISTORY #}
        <div class="content-card section-card">
            <div class="section-header">
                <h2>📜 Match History</h2>
            </div>
            {% if matchHistory is not empty %}
                <div class="table-scroll">
                    <table class="data-table match-history-table">
                        <thead>
                            <tr>
                                <th>Outcome</th>
                                <th>Personal Rating</th>
                                <th>Team</th>
                                <th>Map</th>
                                <th>Duration</th>
                                <th>Date / Time</th>
                                <th style="text-align: center;">Details</th>
                            </tr>
                        </thead>
                        <tbody id="match-history-body">
                            {% for match in matchHistory %}
                                <tr{% if loop.index > 10 %} class="match-history-extra" hidden{% endif %}>
                                    <td data-label="Outcome">
                                        {% if 'win' in match.outcome|lower or 'victor' in match.outcome|lower %}
                                            <span class="outcome-badge outcome-win">WIN</span>
                                        {% else %}
                                            <span class="outcome-badge outcome-loss">LOSS</span>
                                        {% endif %}
                                    </td>
                                    <td data-label="Personal rating">
                                        {% if '+' in match.ratingChange %}
                                            <span class="rating-change-pos">{{ match.ratingChange }}</span>
                                        {% elseif '-' in match.ratingChange %}
                                            <span class="rating-change-neg">{{ match.ratingChange }}</span>
                                        {% else %}
                                            <span>{{ match.ratingChange }}</span>
                                        {% endif %}
                                    </td>
                                    <td data-label="Team">
                                        {% if match.teamUrl %}
                                            <a href="https://armory.warmane.com{{ match.teamUrl }}" target="_blank" style="color: var(--text-primary); text-decoration: none; font-weight: 600;">{{ match.team }}</a>
                                        {% else %}
                                            <span style="font-weight: 600;">{{ match.team }}</span>
                                        {% endif %}
                                    </td>
                                    <td data-label="Map">{{ match.map }}</td>
                                    <td data-label="Duration">{{ match.duration }}</td>
                                    <td data-label="Date / time" style="color: var(--text-secondary); font-size: 0.85rem;">{{ match.startTime }}</td>
                                    <td data-label="Details" style="text-align: center;">
                                        {% if match.gameId %}
                                            <button class="btn-details" onclick="openMatchDetails('{{ match.gameId }}', '{{ characterName }}', '{{ realmName }}')">View Details</button>
                                        {% else %}
                                            <span style="color: var(--text-muted); font-size: 0.8rem;">N/A</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if matchHistory|length > 10 %}
                    <div class="match-history-actions">
                        <button
                            type="button"
                            class="btn-expand-matches"
                            aria-expanded="false"
                            aria-controls="match-history-body"
                            data-total="{{ matchHistory|length }}"
                            onclick="toggleMatchHistory(this)"
                        >
                            Show all {{ matchHistory|length }} matches
                        </button>
                    </div>
                {% endif %}
            {% else %}
                <p style="color: var(--text-muted);">No recent arena/battleground match history recorded.</p>
            {% endif %}
        </div>

    </div>

    {# Match Details Modal #}
    <div id="match-details-modal" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Match Breakdown (<span id="modal-match-id"></span>)</h3>
                <button class="modal-close" onclick="closeMatchDetails()">&times;</button>
            </div>
            <div class="modal-body" id="modal-match-body">
                <p style="color: var(--text-muted); text-align: center;">Loading match breakdown...</p>
            </div>
        </div>
    </div>

    <script>
        function setSpec(specId, btnElement) {
            document.querySelectorAll('.spec-pane').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.glyph-spec-pane').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.spec-toggle-btn').forEach(el => el.classList.remove('active'));

            const targetSpecPane = document.getElementById('spec-pane-' + specId);
            if (targetSpecPane) targetSpecPane.classList.add('active');

            const targetGlyphPane = document.getElementById('glyph-pane-' + specId);
            if (targetGlyphPane) targetGlyphPane.classList.add('active');

            if (btnElement) btnElement.classList.add('active');
        }

        function toggleMatchHistory(button) {
            const isExpanded = button.getAttribute('aria-expanded') === 'true';
            const extraMatches = document.querySelectorAll('.match-history-extra');

            extraMatches.forEach(row => {
                row.hidden = isExpanded;
            });

            button.setAttribute('aria-expanded', String(!isExpanded));
            button.textContent = isExpanded
                ? `Show all ${button.dataset.total} matches`
                : 'Show latest 10 matches';
        }

        async function fetchUwuLogs(button) {
            const status = document.getElementById('uwu-logs-status');
            const results = document.getElementById('uwu-logs-results');
            const specSelect = document.getElementById('uwu-logs-spec');
            const originalLabel = button.textContent.trim();

            button.disabled = true;
            specSelect.disabled = true;
            button.textContent = 'Fetching rankings…';
            status.className = 'uwu-logs-status is-loading';
            status.textContent = 'Fetching the latest rankings from Uwu-logs…';
            results.hidden = true;

            try {
                const response = await fetch(button.dataset.url, {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({spec: specSelect.value})
                });
                const data = await response.json();

                if (!response.ok) {
                    throw new Error(data.error || 'Could not fetch Uwu-logs rankings.');
                }

                renderUwuLogsRankings(data, specSelect.options[specSelect.selectedIndex].text);
                const headerPoints = document.getElementById('header-uwu-points');
                const currentBestPoints = Number(headerPoints?.dataset.points || 0);
                const currentBestRank = Number(headerPoints?.dataset.rank || 0);
                const newPoints = Number(data.overallPoints || 0);
                const newRank = Number(data.overallRank || 0);
                const isBetterParse = newPoints > currentBestPoints
                    || (newPoints === currentBestPoints && newRank > 0 && (currentBestRank <= 0 || newRank < currentBestRank));
                if (headerPoints && isBetterParse) {
                    headerPoints.textContent = newPoints.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
                    headerPoints.dataset.points = String(newPoints);
                    headerPoints.dataset.rank = String(newRank);
                    headerPoints.style.color = getUwuScoreColor(newPoints);
                    document.getElementById('header-uwu-rank').textContent = newRank > 0
                        ? `#${newRank.toLocaleString()}`
                        : '';
                    document.getElementById('header-uwu-spec').textContent = specSelect.options[specSelect.selectedIndex].text;
                }
                status.className = 'uwu-logs-status is-success';
                status.textContent = data.bosses.length > 0
                    ? `${data.cached ? 'Loaded cached' : 'Loaded'} ${data.bosses.length} ranked encounters from Uwu-logs.`
                    : 'Uwu-logs has no ranked encounters for this specialization.';
                results.hidden = false;
            } catch (error) {
                status.className = 'uwu-logs-status is-error';
                status.textContent = error.message || 'Could not fetch Uwu-logs rankings.';
            } finally {
                button.disabled = false;
                specSelect.disabled = false;
                button.textContent = originalLabel;
            }
        }

        function renderUwuLogsRankings(data, specName) {
            document.getElementById('uwu-overall-rank').textContent = data.overallRank > 0
                ? `#${Number(data.overallRank).toLocaleString()}`
                : '—';
            document.getElementById('uwu-overall-points').textContent = Number(data.overallPoints || 0).toLocaleString(undefined, {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
            document.getElementById('uwu-overall-points').style.color = getUwuScoreColor(data.overallPoints);
            document.getElementById('uwu-selected-spec').textContent = specName;

            const rankingsBody = document.getElementById('uwu-rankings-body');
            document.querySelectorAll('.uwu-points-tooltip').forEach(tooltip => tooltip.remove());
            rankingsBody.replaceChildren();

            data.bosses.forEach(boss => {
                const row = document.createElement('tr');
                appendUwuCell(row, boss.name, 'Encounter', true);
                appendUwuCell(row, formatUwuNumber(boss.dps, 2), 'DPS');
                appendUwuCell(row, formatUwuRank(boss.playerRank, boss.totalPlayers), 'Player rank');
                appendUwuCell(row, formatUwuRank(boss.raidRank, boss.totalRaids), 'Raid rank');
                appendUwuPointsCell(row, boss);
                appendUwuCell(row, formatUwuDuration(boss.fastestKillSeconds), 'Fastest kill');
                rankingsBody.appendChild(row);
            });
        }

        function appendUwuCell(row, value, label, emphasize = false) {
            const cell = document.createElement('td');
            cell.dataset.label = label;
            cell.textContent = value ?? '—';
            if (emphasize) cell.classList.add('uwu-encounter-name');
            row.appendChild(cell);
        }

        function appendUwuPointsCell(row, boss) {
            const cell = document.createElement('td');
            cell.dataset.label = 'Points';

            const trigger = document.createElement('button');
            trigger.type = 'button';
            trigger.className = 'uwu-points-trigger';
            trigger.textContent = formatUwuNumber(boss.score, 2);
            trigger.style.color = getUwuScoreColor(boss.score);
            trigger.setAttribute('aria-label', `Points ${trigger.textContent}. Hover or focus for ranking details.`);

            const tooltip = buildUwuPointsTooltip(boss);
            const showTooltip = () => positionUwuPointsTooltip(trigger, tooltip);
            const hideTooltip = () => tooltip.remove();

            trigger.addEventListener('mouseenter', showTooltip);
            trigger.addEventListener('mouseleave', hideTooltip);
            trigger.addEventListener('focus', showTooltip);
            trigger.addEventListener('blur', hideTooltip);
            trigger.addEventListener('keydown', event => {
                if (event.key === 'Escape') {
                    hideTooltip();
                    trigger.blur();
                }
            });

            cell.appendChild(trigger);
            row.appendChild(cell);
        }

        function buildUwuPointsTooltip(boss) {
            const tooltip = document.createElement('div');
            tooltip.className = 'uwu-points-tooltip';
            tooltip.setAttribute('role', 'tooltip');

            appendUwuTooltipRow(tooltip, 'Player rank', boss.playerRank, boss.totalPlayers, boss.playerRankScore);
            appendUwuTooltipRow(tooltip, 'Raid rank', boss.raidRank, boss.totalRaids, boss.raidRankScore);
            appendUwuTooltipRow(tooltip, 'Dps diff', boss.dps, boss.rankOneDps, boss.dpsScore);

            return tooltip;
        }

        function appendUwuTooltipRow(tooltip, label, value, total, score) {
            const row = document.createElement('div');
            row.className = 'uwu-tooltip-row';

            const parts = [
                ['uwu-tooltip-label', label],
                ['uwu-tooltip-number', formatUwuNumber(value, 0)],
                ['uwu-tooltip-separator', '/'],
                ['uwu-tooltip-number', formatUwuNumber(total, 0)],
                ['uwu-tooltip-separator', '='],
                ['uwu-tooltip-score', formatUwuNumber(score, 2)]
            ];

            parts.forEach(([className, text]) => {
                const part = document.createElement(className === 'uwu-tooltip-score' ? 'strong' : 'span');
                part.className = className;
                part.textContent = text;
                if (className === 'uwu-tooltip-score') {
                    part.style.color = getUwuScoreColor(score);
                }
                row.appendChild(part);
            });

            tooltip.appendChild(row);
        }

        function positionUwuPointsTooltip(trigger, tooltip) {
            document.body.appendChild(tooltip);

            const triggerRect = trigger.getBoundingClientRect();
            const tooltipRect = tooltip.getBoundingClientRect();
            const viewportMargin = 8;
            let left = triggerRect.left + (triggerRect.width / 2) - (tooltipRect.width / 2);
            let top = triggerRect.top - tooltipRect.height - viewportMargin;

            left = Math.max(viewportMargin, Math.min(left, window.innerWidth - tooltipRect.width - viewportMargin));
            if (top < viewportMargin) {
                top = triggerRect.bottom + viewportMargin;
                tooltip.classList.add('is-below');
            } else {
                tooltip.classList.remove('is-below');
            }

            tooltip.style.left = `${left}px`;
            tooltip.style.top = `${top}px`;
        }

        function getUwuScoreColor(score) {
            const value = Number(score);
            if (!Number.isFinite(value)) return '#666666';
            if (value < 25) return '#666666';
            if (value < 50) return '#1eff00';
            if (value < 75) return '#0070ff';
            if (value < 90) return '#a335ee';
            if (value < 99) return '#ff3c00';
            if (value < 100) return '#e268a8';
            return '#e5cc80';
        }

        function formatUwuNumber(value, fractionDigits = 0) {
            if (value === null || value === undefined) return '—';
            return Number(value).toLocaleString(undefined, {
                minimumFractionDigits: fractionDigits,
                maximumFractionDigits: fractionDigits
            });
        }

        function formatUwuRank(rank, total) {
            if (!rank) return '—';
            return total
                ? `#${Number(rank).toLocaleString()} / ${Number(total).toLocaleString()}`
                : `#${Number(rank).toLocaleString()}`;
        }

        function formatUwuDuration(seconds) {
            if (seconds === null || seconds === undefined) return '—';
            const totalSeconds = Number(seconds);
            const minutes = Math.floor(totalSeconds / 60);
            const remaining = (totalSeconds % 60).toFixed(1).padStart(4, '0');
            return `${minutes}:${remaining}`;
        }

        function openMatchDetails(gameId, charName, realmName) {
            const modal = document.getElementById('match-details-modal');
            const matchIdSpan = document.getElementById('modal-match-id');
            const body = document.getElementById('modal-match-body');

            matchIdSpan.textContent = gameId;
            body.innerHTML = '<p style="color: var(--text-muted); text-align: center;">Loading match details...</p>';
            modal.style.display = 'flex';

            const classMap = {
                '1': 'Warrior', '2': 'Paladin', '3': 'Hunter', '4': 'Rogue',
                '5': 'Priest', '6': 'Death Knight', '7': 'Shaman', '8': 'Mage',
                '9': 'Warlock', '11': 'Druid'
            };

            fetch(`/character/${encodeURIComponent(charName)}/${encodeURIComponent(realmName)}/match-details/${encodeURIComponent(gameId)}`)
                .then(res => res.json())
                .then(data => {
                    if (!data || data.length === 0) {
                        body.innerHTML = '<p style="color: var(--text-muted); text-align: center;">No player details available for this match.</p>';
                        return;
                    }

                    let html = `
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Player</th>
                                    <th>Team</th>
                                    <th>Damage</th>
                                    <th>Healing</th>
                                    <th>KBs</th>
                                    <th>Deaths</th>
                                    <th>MMR</th>
                                    <th>Rating</th>
                                </tr>
                            </thead>
                            <tbody>
                    `;

                    data.forEach(p => {
                        const className = classMap[p.class] || p.class || 'Unknown';
                        const classClean = className.toLowerCase().replace(/\s+/g, '-');
                        html += `
                            <tr>
                                <td>
                                    <strong class="class-${classClean}">${p.charname}</strong>
                                    <span style="color: var(--text-muted); font-size: 0.75rem;"> (${className})</span>
                                </td>
                                <td>${p.teamnamerich || p.teamname || '-'}</td>
                                <td><strong style="color: var(--accent-gold);">${(p.damage || 0).toLocaleString()}</strong></td>
                                <td><strong style="color: var(--accent-green);">${(p.healing || 0).toLocaleString()}</strong></td>
                                <td>${p.killingblows || 0}</td>
                                <td>${p.deaths || 0}</td>
                                <td>${p.mmr || 0}</td>
                                <td>${p.prating || 0}</td>
                            </tr>
                        `;
                    });

                    html += '</tbody></table>';
                    body.innerHTML = html;
                })
                .catch(err => {
                    body.innerHTML = '<p style="color: var(--accent-red); text-align: center;">Failed to load match details.</p>';
                });
        }

        function closeMatchDetails() {
            document.getElementById('match-details-modal').style.display = 'none';
        }
    </script>
    <script id="item-tooltip-data" type="application/json">{{ itemTooltips|default({})|json_encode(constant('JSON_HEX_TAG') + constant('JSON_HEX_AMP') + constant('JSON_HEX_APOS') + constant('JSON_HEX_QUOT'))|raw }}</script>

    {% if characterModel %}
        <script id="character-model-data" type="application/json">{{ characterModel|json_encode|raw }}</script>
        <script type="module">
            const status = document.getElementById('character-model-status');
            const viewer = document.getElementById('character-model-viewer');
            const hideLoadingStatus = () => status?.remove();
            const canvasObserver = new MutationObserver(() => {
                if (viewer.querySelector('canvas')) {
                    hideLoadingStatus();
                    canvasObserver.disconnect();
                }
            });
            canvasObserver.observe(viewer, { childList: true, subtree: true });

            try {
                const assetUrl = {{ path('app_modelviewer_asset', {
                    environment: 'live',
                    path: '__asset__'
                })|json_encode|raw }};
                window.CONTENT_PATH = new URL(assetUrl.replace('__asset__', ''), window.location.origin).href;

                const character = JSON.parse(document.getElementById('character-model-data').textContent);
                const { generateModels } = await import('https://cdn.jsdelivr.net/npm/wow-model-viewer@1.5.3/+esm');
                await generateModels(1.88, '#character-model-viewer', character);
                hideLoadingStatus();
                canvasObserver.disconnect();
            } catch (error) {
                console.error('Unable to load the character model.', error);
                canvasObserver.disconnect();
                if (status?.isConnected) {
                    status.classList.add('is-error');
                    status.textContent = '3D model unavailable';
                }
            }
        </script>
    {% endif %}
</body>
</html>
