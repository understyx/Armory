<div class="alert-banner alert-warning" role="alert">
    ⚠️ Only Hit and Expertise are currently reliable. All other displayed stats may be inaccurate.
</div>
<div class="stats-panel-heading">
    <div>
        <h3>Stats at level {{ characterDetails.level }}</h3>
        <p>Current character only: (race + class at this level + equipped gear) × permanent talent multipliers.</p>
        <a class="stats-debug-link" href="{{ path('app_character_stats', {'characterName': characterName, 'realmName': realmName}) }}">Open full calculation breakdown</a>
    </div>
    {% if calculatedStatsBySpec|length > 1 %}
        <div class="stats-spec-tabs" role="tablist" aria-label="Stats specialization">
            {% for entry in calculatedStatsBySpec %}
                <button
                    id="stats-spec-tab-{{ entry.specId }}"
                    class="stats-spec-tab{% if loop.first %} active{% endif %}"
                    type="button"
                    role="tab"
                    aria-selected="{{ loop.first ? 'true' : 'false' }}"
                    aria-controls="stats-spec-panel-{{ entry.specId }}"
                    onclick="setStatsSpec('{{ entry.specId }}', this)"
                >{{ entry.specName }}{% if entry.pointsSummary %} ({{ entry.pointsSummary }}){% endif %}</button>
            {% endfor %}
        </div>
    {% endif %}
</div>

{% for entry in calculatedStatsBySpec %}
    {% set calculatedStats = entry.stats %}
    <div
        id="stats-spec-panel-{{ entry.specId }}"
        class="stats-spec-panel"
        role="tabpanel"
        aria-labelledby="stats-spec-tab-{{ entry.specId }}"
        {% if not loop.first %}hidden{% endif %}
    >
        {% if calculatedStats.available|default(false) %}
            <div class="calculated-stat-table-wrap">
                <table class="calculated-stat-table">
                    <thead>
                        <tr>
                            <th>Attribute</th>
                            <th>Race</th>
                            <th>Class at {{ calculatedStats.level }}</th>
                            <th>Gear</th>
                            <th>Talent</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for stat in calculatedStats.primary %}
                            <tr>
                                <th scope="row">{{ stat.name }}</th>
                                <td>{{ stat.race >= 0 ? '+' : '' }}{{ stat.race }}</td>
                                <td>{{ stat.classAtLevel }}</td>
                                <td>{{ stat.gear >= 0 ? '+' : '' }}{{ stat.gear }}</td>
                                <td>
                                    {{ stat.talents >= 0 ? '+' : '' }}{{ stat.talents }}
                                    {% if stat.talentPercent != 0 %}<small>({{ stat.talentPercent }}%)</small>{% endif %}
                                </td>
                                <td class="calculated-stat-total">{{ stat.total }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if calculatedStats.secondary is not empty %}
                <h4 class="stat-subheading">Gear stats</h4>
                <div class="secondary-stat-grid" aria-label="Equipment stats">
                    {% for stat in calculatedStats.secondary %}
                        <div class="secondary-stat-card">
                            <span>{{ stat.name }}</span>
                            <strong>{{ stat.value|number_format }}</strong>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            {% if calculatedStats.ratings is not empty %}
                <h4 class="stat-subheading">Combat stats at level {{ calculatedStats.level }}</h4>
                <div class="rating-conversion-grid">
                    {% for rating in calculatedStats.ratings %}
                        <div class="rating-conversion-card">
                            <span class="rating-conversion-name">{{ rating.name }}</span>
                            <strong>{{ rating.value|number_format(2) }}{{ rating.unit }}</strong>
                            {% if rating.isCriticalStrike|default(false) %}
                                <small>{{ rating.basePercent|number_format(2) }}% base · {{ rating.attributeValue }} {{ rating.attribute }} = {{ rating.attributePercent|number_format(2) }}% · {{ rating.rating }} rating = {{ rating.ratingPercent|number_format(2) }}%{% if rating.flatBonusPercent != 0 %} · talents/stance = +{{ rating.flatBonusPercent|number_format(2) }}%{% endif %}</small>
                            {% else %}
                                <small>{{ rating.rating }} rating · {{ rating.ratingPerUnit }} per {{ rating.unitLabel }}{% if rating.flatBonusPercent != 0 %} · talents/stance = +{{ rating.flatBonusPercent|number_format(2) }}%{% endif %}</small>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            {% if calculatedStats.hitBonuses is not empty %}
                <h4 class="stat-subheading">Talent hit bonuses</h4>
                <div class="hit-bonus-grid">
                    {% for scope, percent in calculatedStats.hitBonuses %}
                        <div class="hit-bonus-card">
                            <span>{{ scope }}</span>
                            <strong>+{{ percent|number_format(2) }}%</strong>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            {% if calculatedStats.talentModifiers is not empty %}
                <div class="talent-modifier-summary">
                    <strong>Applied talents:</strong>
                    {% for talent in calculatedStats.talentModifiers %}
                        <span>{{ talent.name }} ({{ talent.points }} {{ talent.points == 1 ? 'point' : 'points' }})</span>{% if not loop.last %}, {% endif %}
                    {% endfor %}
                </div>
            {% endif %}

            {% if calculatedStats.assumedEffects is not empty %}
                <div class="talent-modifier-summary">
                    <strong>Assumed combat state:</strong>
                    {% for effect in calculatedStats.assumedEffects %}<span>{{ effect.name }} — {{ effect.reason }}</span>{% if not loop.last %}, {% endif %}{% endfor %}
                </div>
            {% endif %}

            <ul class="stat-calculation-notes">
                {% for note in calculatedStats.notes %}<li>{{ note }}</li>{% endfor %}
            </ul>
        {% else %}
            <p class="stat-unavailable">{{ calculatedStats.reason|default('Stats could not be calculated for this character.') }}</p>
        {% endif %}
    </div>
{% else %}
    <p class="stat-unavailable">Stats could not be calculated for this character.</p>
{% endfor %}
