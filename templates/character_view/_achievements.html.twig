<div class="achievements-panel-heading">
    <div>
        <h3>Wrath raid progression</h3>
        <p>Raid wing and end-boss achievements reported by Warmane.</p>
    </div>
    <a href="{{ sourceUrl }}" target="_blank" rel="noopener">View on Warmane</a>
</div>

<div class="raid-group-tabs" role="tablist" aria-label="Wrath raid group">
    {% for routeKey, tab in achievementTabs %}
        <button
            id="raid-group-tab-{{ routeKey }}"
            class="raid-group-tab{% if loop.first %} active{% endif %}"
            type="button"
            role="tab"
            aria-selected="{{ loop.first ? 'true' : 'false' }}"
            aria-controls="raid-group-panel-{{ routeKey }}"
            data-group-url="{{ path('app_character_achievement_group', {'characterName': characterName, 'realmName': realmName, 'groupName': routeKey}) }}"
            onclick="setAchievementGroupTab('{{ routeKey }}', this)"
        >{{ tab.title }}</button>
    {% endfor %}
</div>

<div class="raid-group-panels">
    {% for routeKey, tab in achievementTabs %}
        <div
            id="raid-group-panel-{{ routeKey }}"
            class="raid-group-panel"
            role="tabpanel"
            aria-labelledby="raid-group-tab-{{ routeKey }}"
            {% if not loop.first %}hidden{% endif %}
        >
            <div class="achievements-loading">
                <span class="model-loading-spinner" aria-hidden="true"></span>
                Loading {{ tab.title }} achievements…
            </div>
        </div>
    {% endfor %}
</div>
