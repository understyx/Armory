<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="{% block description %}Warmane Armory character and guild profiles.{% endblock %}">
        <title>{% block title %}Warmane Armory{% endblock %}</title>
        <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">

        {% block stylesheets %}
            <style>
                body {
                    font-family: 'Roboto', sans-serif;
                    font-size: 16px;
                    line-height: 1.6;
                    color: #f0f2f8;
                    background-color: #0b0c10;
                }

                h1, h2, h3, h4, h5, h6 {
                    font-family: 'Montserrat', sans-serif;
                    font-weight: 700;
                    color: #f0f2f8;
                }

                .container-fluid.app-container {
                    padding-top: 2rem;
                    padding-bottom: 2rem;
                    min-height: 100vh;
                    display: flex;
                    flex-direction: column;
                    align-items: center;
                }

                .card.app-card {
                    width: 100%;
                    max-width: 500px;
                    border: 1px solid #262938;
                    background: #151720;
                    color: #f0f2f8;
                    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.4);
                    border-radius: 8px;
                }

                .btn-discord {
                    background-color: #5865f2;
                    border-color: #5865f2;
                    color: white;
                    padding: .75rem 1.5rem;
                    border-radius: 5px;
                    font-weight: 500;
                    display: block;
                    width: 100%;
                }
                .btn-discord:hover {
                    background-color: #4752c4;
                    border-color: #4752c4;
                    color: white;
                }

                .alert {
                    border-radius: 4px;
                    padding: 1rem 1.5rem;
                }
            </style>
        {% endblock %}

        {% block javascripts %}
            {# Bootstrap JS bundle - needs Popper.js, typically loaded via importmap #}
            {# <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script> #}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <div class="container-fluid app-container">
            {% block body %}{% endblock %}
        </div>
    </body>
</html>
