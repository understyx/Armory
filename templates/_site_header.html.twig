{% set searchRealm = currentRealm|default(realmName|default('Icecrown')) %}
{% set headerUser = app.request and app.request.hasPreviousSession ? app.user : null %}
<header class="site-header">
    <a class="site-header-brand" href="{{ path('app_homepage') }}" aria-label="Warmane Armory home">Armory</a>
    <form class="character-search site-header-search" action="{{ path('app_characters') }}" method="get" aria-label="Search characters and guilds">
        <label class="visually-hidden" for="site-search-name">Character or guild name</label>
        <input
            id="site-search-name"
            class="character-search-input"
            type="search"
            name="character"
            placeholder="Character or guild name"
            aria-label="Character or guild name"
            autocomplete="off"
            required
        >

        <label class="visually-hidden" for="site-search-type">Search type</label>
        <select id="site-search-type" class="character-search-type" name="type" aria-label="Search type">
            <option value="character">Character</option>
            <option value="guild">Guild</option>
        </select>

        <label class="visually-hidden" for="site-search-realm">Realm</label>
        <select id="site-search-realm" class="character-search-realm" name="realm" aria-label="Realm">
            {% for realm in ['Icecrown', 'Lordaeron', 'Onyxia', 'Blackrock'] %}
                <option value="{{ realm }}"{% if realm == searchRealm %} selected{% endif %}>{{ realm }}</option>
            {% endfor %}
        </select>

        <button class="character-search-button" type="submit" aria-label="Search">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.35-4.35"></path>
            </svg>
            <span>Search</span>
        </button>
    </form>
    <div class="site-header-account">
        {% if headerUser %}
            {% set avatarExtension = headerUser.discordAvatarHash starts with 'a_' ? 'gif' : 'png' %}
            {% set discordAvatar = headerUser.discordAvatarHash
                ? 'https://cdn.discordapp.com/avatars/' ~ headerUser.discordId ~ '/' ~ headerUser.discordAvatarHash ~ '.' ~ avatarExtension ~ '?size=64'
                : 'https://cdn.discordapp.com/embed/avatars/0.png' %}
            <a class="site-account-link" href="{{ path('app_account') }}">
                <img src="{{ discordAvatar }}" alt="" width="30" height="30" loading="lazy">
                <span>{{ headerUser.discordUsername|default('Discord user') }}</span>
            </a>
            <form action="{{ path('app_logout') }}" method="post" class="site-logout-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button type="submit" class="site-logout-button">Log out</button>
            </form>
        {% else %}
            <a class="discord-login-button" href="{{ path('connect_discord_start') }}">
                <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                    <path d="M19.7 5.3a18.2 18.2 0 0 0-4.5-1.4l-.6 1.2a16.7 16.7 0 0 0-5.1 0l-.6-1.2a18.2 18.2 0 0 0-4.5 1.4C1.6 9.4.8 13.4 1.2 17.4a18.3 18.3 0 0 0 5.5 2.8l1.2-1.9-1.9-.9.5-.4a13 13 0 0 0 11 0l.5.4-1.9.9 1.2 1.9a18.3 18.3 0 0 0 5.5-2.8c.5-4.6-.8-8.5-3.1-12.1ZM8.7 14.9c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Zm6.6 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2Z"/>
                </svg>
                <span>Log in with Discord</span>
            </a>
        {% endif %}
    </div>
</header>
<script type="module" src="{{ asset('search-preferences.js') }}"></script>
